# 生产环境变量
# 部署时通过 CI 注入或调整后端 API 地址

VITE_API_PREFIX=/api
VITE_API_TARGET=https://api.example.com
VITE_APP_TITLE=ZTest

# CDN 源（生产构建时把 vue/echarts/three/ol 等替换为 CDN 引入）
#   jsdelivr   默认，国内外都快
#   unpkg      国外快
#   bootcdn    国内最快（推荐国内服务器部署时用）
#   off        完全不走 CDN（与 dev 一致，全量本地打包）
VITE_CDN_PROVIDER=jsdelivr
