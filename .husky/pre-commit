#!/usr/bin/env sh
# pre-commit 钩子：在 git commit 之前执行
#
# 流程：
#   1. lint-staged 对"暂存区"文件跑 ESLint / Stylelint / Prettier
#      - .js / .vue  → npx eslint --fix（自动修复 + 未修复报错就阻断提交）
#      - .css/.less/.scss/.vue  → npx stylelint --fix
#      - 其他源码文件 → npx prettier --write
#   2. 任一 lint 有 error → 非零退出 → git commit 被阻断
#
# 注：
#   - 只检查"暂存区文件"，不会扫描整个项目（性能保证）
#   - --fix 后的修复会自动被 git add 回暂存区
#   - 想跳过检查临时提交用：git commit --no-verify（仅应急）
. "$(dirname "$0")/_/husky.sh"

npx lint-staged
