# 开发环境变量
# 复制本文件为 .env.development.local 覆盖个人配置

# API 代理前缀（vite.config.js 中读取 VITE_API_PREFIX）
VITE_API_PREFIX=/api

# API 代理目标地址（后端服务地址）
VITE_API_TARGET=http://localhost:8080

# 请求超时时间（毫秒，request.js 读取，默认 15000）
VITE_API_TIMEOUT=15000

# 应用标题
VITE_APP_TITLE=ZTest 开发环境

# Cesium ion 访问令牌（启用全球地形等 ion 服务必需，避免默认 token 提示）
# 获取：https://cesium.com/ion/signup → 复制 Default Token
# 请填到 .env.development.local（不入版本库），本行留空占位即可
VITE_CESIUM_ION_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJub25jZSI6IjBsUDFVc3hmcU1USC03eGciLCJqdGkiOiI4NDg1MjI1Yi1hYTIzLTQ4YjEtODk4Zi1lNWFkYWJjMDEyYjEiLCJpZCI6NDc0MzI0LCJpc3MiOiJodHRwczovL2FwaS5jZXNpdW0uY29tIiwiYXVkIjoidW5kZWZpbmVkX2RlZmF1bHQiLCJpYXQiOjE3ODc5MTA1NTJ9.OuQn2tM63qugo7CZhA7BPz4-NTljoO9Q0y8D_qCi5gk
