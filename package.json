{
  "name": "ztest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cesium:copy": "node -e \"const fs=require('fs');['Assets','ThirdParty','Widgets','Workers'].forEach(d=>fs.cpSync('node_modules/cesium/Build/Cesium/'+d,'public/cesium/'+d,{recursive:true}));console.log('cesium assets copied to public/cesium')\"",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "lint:check": "eslint . --cache --max-warnings 0",
    "lint:style": "stylelint \"**/*.{css,less,scss,vue}\" --cache",
    "lint:style:fix": "stylelint \"**/*.{css,less,scss,vue}\" --cache --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:all": "npm run lint && npm run lint:style && npm run format:check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,vue,mjs,cjs}": "eslint --cache --fix",
    "*.{css,less,scss,vue}": "stylelint --cache --fix",
    "*.{html,json,md,yml,yaml,svg}": "prettier --write"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.19.0",
    "cesium": "^1.144.0",
    "echarts": "^5.4.3",
    "echarts-gl": "^2.0.9",
    "element-plus": "^2.11.4",
    "html2canvas": "^1.4.1",
    "ol": "^10.6.1",
    "pinia": "^3.0.3",
    "three": "^0.183.2",
    "vue": "^3.5.22",
    "vue-easy-print": "^0.0.8",
    "vue-print-nb": "^1.7.5",
    "vue-router": "^4.5.1",
    "vue-screen-adapter": "^1.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@stylistic/eslint-plugin": "^2.13.0",
    "@stylistic/stylelint-plugin": "^5.3.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^9.33.0",
    "highcharts": "^12.4.0",
    "husky": "^9.1.7",
    "less": "^4.9.0",
    "less-loader": "^8.0.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "sass-embedded": "^1.93.2",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.1.7",
    "vite-plugin-cdn-import": "^1.0.1",
    "vite-plugin-compression": "^0.5.1",
    "vue-eslint-parser": "^9.4.3"
  }
}
